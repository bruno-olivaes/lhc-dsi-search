\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Metrological evaluation of Discrete Scale Invariance in LHC dimuon invariant mass distributions. Top: Reconstructed $\mu ^+\mu ^-$ event spectrum and fitted smooth Standard Model continuum. Middle: Standardized pull residuals $y = (N_i - N_0)/\sigma _i$ in log-mass $u = \ln m$. Bottom: Generalized Lomb--Scargle periodogram demonstrating that observed peaks remain well below the multiplicity-corrected certification threshold ($p = 0.324$), confirming the experimental null result.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:lhc_periodogram}{{1}{4}{Metrological evaluation of Discrete Scale Invariance in LHC dimuon invariant mass distributions. Top: Reconstructed $\mu ^+\mu ^-$ event spectrum and fitted smooth Standard Model continuum. Middle: Standardized pull residuals $y = (N_i - N_0)/\sigma _i$ in log-mass $u = \ln m$. Bottom: Generalized Lomb--Scargle periodogram demonstrating that observed peaks remain well below the multiplicity-corrected certification threshold ($p = 0.324$), confirming the experimental null result}{figure.1}{}}
